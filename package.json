{
  "name": "mmdb-watchlist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A tiny watchlist library. Used for pull request practice.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "demo": "node --experimental-strip-types src/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
